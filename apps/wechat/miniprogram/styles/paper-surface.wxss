/*
 * The mini program shares the Web story page's pale rice-paper direction.
 * Keep the texture in CSS so it is local, cacheable, and cheap to paint.
 */
page {
  color: #20211f;
  background-color: #f5f5f1;
  background-image:
    radial-gradient(circle at 8% -12%, rgba(255, 255, 255, .98), transparent 34%),
    radial-gradient(circle at 94% 4%, rgba(196, 154, 36, .026), transparent 24%),
    linear-gradient(180deg, #ffffff 0%, #f5f5f1 62%, #ebebe8 100%);
}

/* The Web app owns the bundled Huiwen Mincho subset; mini program canvas
 * safely falls back to Songti when a device does not expose the face. */
.paper-title,
.paper-display,
.paper-canvas-text {
  font-family: "Huiwen Mincho", "Songti SC", "STSong", Georgia, serif;
  font-weight: 400;
}

.paper-surface-card {
  border: 2rpx solid rgba(32, 33, 31, .16);
  border-radius: 8rpx 10rpx 7rpx 9rpx;
  background: rgba(255, 255, 252, .88);
  box-shadow: 4rpx 5rpx 0 rgba(42, 41, 36, .045), 0 18rpx 36rpx rgba(41, 42, 38, .04);
}

/* Paper-cut controls: a white card, a dark hairline and a tiny offset. */
.btn-primary,
.btn-secondary,
.mini-action,
.choice-button,
.scene-button,
.render-button {
  border-radius: 8rpx;
  box-shadow: 0 9rpx 18rpx rgba(42, 41, 36, .06), 4rpx 5rpx 0 rgba(42, 41, 36, .045);
}

.btn-secondary,
.mini-action,
.choice-button,
.scene-button,
.render-button {
  background: #fdfdfb;
}

.btn-primary {
  color: #20211f;
  background: #fdfdfb;
  border-color: #20211f;
}

.btn-primary:active,
.btn-secondary:active,
.mini-action:active,
.choice-button:active,
.scene-button:active,
.render-button:active {
  box-shadow: 1rpx 1rpx 0 rgba(32, 33, 31, .14);
}

.paper-focus:focus,
.paper-focus:focus-visible {
  outline: 4rpx solid rgba(65, 111, 153, .28);
  outline-offset: 4rpx;
}

@media (prefers-reduced-motion: reduce) {
  page {
    background-image: linear-gradient(180deg, #ffffff 0%, #f5f5f1 62%, #ebebe8 100%);
  }
}
