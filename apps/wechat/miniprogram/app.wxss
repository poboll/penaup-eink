@import "./styles/paper-surface.wxss";

page {
  background-color: #fafaf7;
  color: #20211f;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Hiragino Sans GB", sans-serif;
  line-height: 1.55;
}

view, text, button, input, textarea, picker, slider, image, canvas { box-sizing: border-box; }
button::after { border: 0; }
button { margin: 0; font-family: inherit; }

.container { min-height: 100vh; padding: 34rpx 36rpx 220rpx; }
.tab-bar-spacer { height: 168rpx; }

.btn-primary,
.btn-secondary,
.btn-disconnect {
  min-height: 92rpx;
  padding: 20rpx 28rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: .4rpx;
}

.btn-primary {
  color: #fffefa;
  background: #20211f;
  border: 2rpx solid #20211f;
  box-shadow: 0 12rpx 24rpx rgba(26, 27, 24, .12);
}

.btn-primary:active,
.btn-secondary:active,
.btn-disconnect:active,
.cta:active,
.m-card:active,
.set-row:active,
.tpl:active,
.recent:active,
.device-item:active { transform: translateY(2rpx); opacity: .86; }

.btn-primary[disabled],
.btn-secondary[disabled] {
  color: #a5a69e;
  background: #e3e3dc;
  border-color: #d5d5cd;
  box-shadow: none;
}

.btn-secondary,
.btn-disconnect { color: #20211f; background: #fffefa; border: 2rpx solid #b6b7b2; }
.btn-secondary.warning { color: #88680c; border-color: #d8bd66; }
.btn-secondary.danger { color: #b65347; border-color: #d79b93; }

.info-text,
.setting-hint,
.dev-meta,
.m-sub,
.r-time,
.t-name,
.status-sub,
.transfer-msg,
.transfer-status,
.transfer-progress { color: #656761; }

.label {
  margin: 48rpx 0 18rpx;
  color: #4d73ad;
  font: 600 20rpx/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: 3rpx;
}
.label::before { content: "PENAUP / "; color: #a2a39b; }

.pill,
.dev-tag,
.cnt,
.list-count,
.set-d,
.filename-label,
.filename-ext,
.network-label,
.device-id { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }

.cta,
.cta-half { color: #fffefa; background: #20211f; border-radius: 8rpx; box-shadow: 0 12rpx 24rpx rgba(26, 27, 24, .12); }
.cta-teal { background: #4d73ad; }
.cta-t { color: inherit; font-weight: 600; }
.cta-sub, .cta-hint { color: rgba(247, 247, 242, .7); }

.device-row,
.status-card,
.panel-c,
.settings-section,
.canvas-container,
.adv-row,
.transfer-modal,
.color-picker-modal,
.custom-panel,
.set-card,
.memo-list,
.memo-empty {
  border: 2rpx solid #d5d5d1;
  border-radius: 8rpx;
  background: #fffefa;
  box-shadow: 0 14rpx 28rpx rgba(26, 27, 24, .07);
}

.device-row { padding: 24rpx; }
.dev-thumb,
.t-ic,
.r-img,
.m-ic,
.device-icon,
.status-icon { background: #f4f4f0; border: 2rpx solid #c3c4bb; }

.dev-name,
.m-name,
.setting-label,
.lr-name,
.status-title,
.list-title,
.section-header,
.set-t,
.picker-title { color: #20211f; }

.dot { background: #55765e; }
.dot.off { background: #b7b8b0; }

.m-card,
.m-card.c-red,
.m-card.c-teal,
.m-card.c-purple,
.m-card.c-blue,
.m-card.c-yellow,
.m-card.c-pink,
.recent,
.tpl {
  border: 2rpx solid #d5d5d1;
  border-radius: 8rpx;
  background: #fffefa;
  box-shadow: none;
}

.m-card .m-ic { background: #f4f4f0; }
.m-card .m-sub { color: #656761; }
.m-card.c-yellow::after { background: #c49a24; color: #20211f; }
.cc-emo { opacity: .15; filter: grayscale(1); }
.adv-row { padding: 24rpx; }
.adv-row .m-ic { background: #4d73ad; border-color: #4d73ad; }
.adv-a { color: #4d73ad; }

.recent .r-img,
.tpl .t-ic { background: #f4f4f0; }
.pill { color: #20211f; background: #c49a24; }
.clear-recent { color: #b65347; background: transparent; }

.section-header { background: transparent; border-bottom: 2rpx solid #d5d5d1; }
.section-content { background: transparent; }
.setting-item, .list-row { border-bottom-color: #d5d5d1; }

.picker-value,
.file-name-input,
.filename-display,
.filename-edit-row,
input,
textarea,
.custom-input,
.theme-select,
.network-input {
  color: #20211f;
  background: #fffefa;
  border-color: #b6b7b2;
  border-radius: 6rpx;
}

input::placeholder, textarea::placeholder { color: #a5a69e; }
.progress-bar, .modal-progress-bar { background: #e7e7df; }
.progress-fill, .modal-progress-fill { background: #4d73ad; }
.transfer-container { border-color: #d5d5d1; background: #fffefa; }
.transfer-percent { color: #4d73ad; }
.transfer-overlay, .preview-overlay, .color-picker-overlay { background: rgba(26, 27, 24, .62); }

.status-connected,
.action-buttons .btn-primary,
.action-buttons .btn-disconnect {
  color: #fffefa;
  background: #20211f;
  border-color: #20211f;
  box-shadow: 0 12rpx 24rpx rgba(26, 27, 24, .14);
}
.status-connected .status-title, .status-connected .status-sub { color: #fffefa; }
.status-disconnected { background: #fffefa; border-color: #d5d5d1; }
.status-icon, .status-icon.scanning { background: #f4f4f0; color: #4d73ad; }
.device-icon, .device-icon.pro { background: #4d73ad; border-color: #4d73ad; box-shadow: none; }
.device-icon.max { background: #55765e; border-color: #55765e; }
.battery-fill { background: #c49a24; }
.list-count { background: #4d73ad; box-shadow: none; }

.switch-row,
.network-input-group,
.wake-slider-row,
.action-controls,
.wifi-status-row { border-bottom-color: #d5d5d1; }

@keyframes penaup-fade-up {
  from { opacity: 0; transform: translateY(14rpx); }
  to { opacity: 1; transform: none; }
}
@keyframes penaup-pulse {
  0%, 100% { opacity: .38; }
  50% { opacity: 1; }
}
@keyframes penaup-scan {
  0% { transform: translateY(-100%); opacity: 0; }
  20% { opacity: .9; }
  100% { transform: translateY(420%); opacity: 0; }
}

.banner-strip,
.create-grid,
.device-row,
.canvas-container,
.panel-c,
.set-group,
.tpl-card,
.status-card { animation: penaup-fade-up .55s ease both; }
.bn-dot.on, .meta-dot.is-connected { animation: penaup-pulse 1.8s ease-in-out infinite; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
}
@media (max-width: 620px) {
  .container { padding-left: 28rpx; padding-right: 28rpx; }
}

/* Shared paper-cut controls. Keep the action geometry stable across the
 * home page, template pages, BLE flow, and transfer sheets. Selected actions
 * use a quiet sage paper instead of a heavy dark pill. */
.btn-primary,
.btn-secondary,
.btn-disconnect,
.mini-action,
.choice-button,
.scene-button,
.render-button {
  min-width: 0;
  min-height: 88rpx;
  padding: 18rpx 24rpx;
  color: #20211f;
  border: 2rpx solid rgba(32, 33, 31, .52);
  border-radius: 8rpx;
  background: rgba(255, 254, 250, .88);
  box-shadow: 4rpx 5rpx 0 rgba(42, 41, 36, .08), 0 9rpx 18rpx rgba(42, 41, 36, .045);
  transition: color .22s ease, background-color .22s ease, border-color .22s ease, box-shadow .22s ease, transform .22s ease;
}

.btn-primary:active,
.btn-secondary:active,
.btn-disconnect:active,
.mini-action:active,
.choice-button:active,
.scene-button:active,
.render-button:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 rgba(42, 41, 36, .16);
}

.btn-primary:active,
.btn-primary:focus,
.btn-primary:focus-visible {
  color: #20211f;
  border-color: #4f775d;
  background: #b7d6c0;
}

.btn-secondary:active,
.btn-secondary:focus,
.btn-secondary:focus-visible,
.mini-action:active,
.mini-action:focus,
.mini-action:focus-visible {
  background: #fffefa;
  border-color: #20211f;
}

.choice-button.is-active,
.scene-button.is-active,
.render-button.is-active {
  color: #20211f;
  border-color: #4f775d;
  background: rgba(183, 214, 192, .42);
  box-shadow: inset 0 -5rpx #4f775d, 3rpx 4rpx 0 rgba(79, 119, 93, .08);
}

.paper-surface-card,
.device-row,
.status-card,
.panel-c,
.settings-section,
.canvas-container,
.set-card,
.memo-list,
.memo-empty {
  border-radius: 8rpx 10rpx 7rpx 9rpx;
  background: rgba(255, 255, 252, .76);
}

.canvas-wrap,
.preview-paper,
.weread-card {
  background: rgba(255, 255, 252, .78);
}

.cta,
.cta-half {
  color: #20211f;
  background: rgba(255, 254, 250, .88);
  border: 2rpx solid rgba(32, 33, 31, .52);
  border-radius: 8rpx;
  box-shadow: 4rpx 5rpx 0 rgba(42, 41, 36, .08), 0 9rpx 18rpx rgba(42, 41, 36, .045);
}

.cta-teal {
  color: #20211f;
  background: #b7d6c0;
  border-color: #4f775d;
}

.cta:active,
.cta-half:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 rgba(42, 41, 36, .16);
}

/* Final Penaup paper pass: near-white grass paper, quiet keylines and one
 * readable action rhythm across every mini-program page. */
page {
  background-color: #fafaf7;
  background-image:
    radial-gradient(circle at 8% -12%, rgba(255, 255, 252, .99), transparent 34%),
    radial-gradient(circle at 94% 4%, rgba(196, 154, 36, .028), transparent 24%),
    repeating-linear-gradient(104deg, rgba(70, 70, 65, .011) 0 1px, transparent 1px 18px),
    repeating-linear-gradient(16deg, rgba(70, 70, 65, .008) 0 1px, transparent 1px 13px),
    linear-gradient(180deg, #fffefa 0%, #fafaf7 58%, #f4f4f0 100%);
}

.btn-primary,
.btn-secondary,
.btn-disconnect,
.mini-action,
.choice-button,
.scene-button,
.render-button,
.mode-button {
  border-radius: 7rpx 9rpx 6rpx 8rpx;
  box-shadow: 0 9rpx 18rpx rgba(42, 41, 36, .055), 4rpx 5rpx 0 rgba(42, 41, 36, .04);
}

.btn-primary {
  color: #fffefa;
  background: #20211f;
  border-color: #20211f;
}

.btn-primary:active {
  color: #20211f;
  background: #b7d6c0;
  border-color: #4f775d;
}

.btn-secondary,
.btn-disconnect,
.mini-action,
.choice-button,
.scene-button,
.render-button,
.mode-button {
  background: rgba(255, 255, 252, .86);
}

.button-row,
.action-controls,
.connect-row,
.output-actions,
.cta-row {
  align-items: stretch;
}

.button-row > button,
.action-controls > button,
.connect-row > button,
.output-actions > button,
.cta-row > view {
  min-width: 0;
  box-sizing: border-box;
}

.info-text,
.setting-hint,
.dev-meta,
.m-sub,
.status-sub,
.transfer-msg,
.transfer-status,
.transfer-progress {
  font-size: 22rpx;
}

.label,
.field-label,
.choice-label,
.network-label,
.device-id,
.lr-meta,
.set-d,
.file-size-text {
  font-size: 20rpx;
}

@media (max-width: 620px) {
  .container { padding-left: 28rpx; padding-right: 28rpx; }
  .cta-row { flex-direction: column; }
  .cta-row > view { width: 100%; }
}

@media (prefers-reduced-motion: reduce) {
  page {
    background-image: linear-gradient(180deg, #fffefa 0%, #fafaf7 58%, #f4f4f0 100%);
  }
}
