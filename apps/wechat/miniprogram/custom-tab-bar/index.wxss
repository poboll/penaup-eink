.tab-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 99;
  height: 116rpx;
  display: flex;
  align-items: stretch;
  padding: 10rpx;
  background: rgba(255, 255, 252, .94);
  border: 2rpx solid #d5d5d1;
  border-radius: 12rpx;
  box-shadow: 4rpx 5rpx 0 rgba(42, 41, 36, .045), 0 16rpx 36rpx rgba(42, 41, 36, .08);
  backdrop-filter: blur(14px);
}
.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #858780;
  transition: color .2s ease, transform .2s ease;
}
.tab-item::before {
  content: '';
  position: absolute;
  top: 0;
  width: 28rpx;
  height: 4rpx;
  background: transparent;
}
.tab-item.active { color: #20211f; }
.tab-item.active::before { background: #4d73ad; }
.tab-item:active { transform: translateY(2rpx); }
.tab-icon { width: 38rpx; height: 38rpx; opacity: .58; }
.tab-item.active .tab-icon { opacity: 1; }
.tab-text { font-size: 21rpx; letter-spacing: 1rpx; }
