@import "../../styles/penaup-pages.wxss";

.panel-c { padding: 0 22rpx; margin-bottom: 18rpx; }
.panel-head { display: flex; align-items: center; justify-content: space-between; min-height: 82rpx; border-bottom: 2rpx solid #d8d8cf; font-size: 26rpx; font-weight: 600; }
.head-actions { display: flex; align-items: center; gap: 18rpx; }
.cnt { color: #4d75b6; font-size: 20rpx; font-weight: 500; }
.del { color: #b65347; font-size: 21rpx; font-weight: 500; }
.list-row { display: flex; align-items: center; gap: 14rpx; min-height: 94rpx; padding: 14rpx 0; border-bottom: 2rpx solid #d8d8cf; }
.list-row:last-child { border-bottom: 0; }
.file-row.cur { margin-left: -22rpx; margin-right: -22rpx; padding-left: 22rpx; padding-right: 22rpx; background: #f0f1ec; box-shadow: inset 6rpx 0 #4d75b6; }
.lr-thumb { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 76rpx; height: 76rpx; color: #74766d; background: #e9e9e1; border: 2rpx solid #c3c4bb; font: 18rpx ui-monospace, SFMono-Regular, Menlo, monospace; text-align: center; }
.lr-thumb.cur { color: #f7f7f2; background: #1a1b18; border-color: #1a1b18; }
.cur-badge { position: absolute; margin-top: -86rpx; margin-left: 70rpx; width: 84rpx; padding: 4rpx 0; color: #f7f7f2; background: #4d75b6; font-size: 16rpx; }
.lr-img { flex-shrink: 0; width: 76rpx; height: 76rpx; background: #e9e9e1; }
.lr-info { flex: 1; min-width: 0; }
.lr-name { overflow: hidden; font-size: 24rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.lr-meta { margin-top: 5rpx; overflow: hidden; color: #74766d; font: 19rpx ui-monospace, SFMono-Regular, Menlo, monospace; text-overflow: ellipsis; white-space: nowrap; }
.lr-del, .lr-tag { flex-shrink: 0; padding: 10rpx 0 10rpx 10rpx; color: #b65347; font-size: 20rpx; }
.lr-tag { color: #4d75b6; }
.cta { display: flex; flex-direction: column; align-items: flex-start; width: 100%; min-height: 118rpx; padding: 24rpx; }
.cta > text:first-child { font-size: 29rpx; font-weight: 600; }
.cta-hint { margin-top: 8rpx; font-size: 21rpx; }
.batch-cards { width: 100%; height: 126rpx; margin-bottom: 18rpx; white-space: nowrap; }
.b-card { position: relative; display: inline-block; width: 92rpx; height: 112rpx; margin-right: 12rpx; padding: 6rpx; background: #e9e9e1; border: 2rpx solid #d8d8cf; vertical-align: top; }
.b-card.active { border-color: #4d75b6; box-shadow: 0 0 0 4rpx rgba(77, 117, 182, .15); }
.b-card.done { border-color: #6f936e; opacity: .66; }
.bc-photo { width: 100%; height: 100%; }
.bc-photo-empty { display: flex; align-items: center; justify-content: center; color: #74766d; font-size: 28rpx; }
.bc-badge { position: absolute; right: -8rpx; top: -8rpx; width: 28rpx; height: 28rpx; color: #f7f7f2; background: #6f936e; border-radius: 50%; font-size: 18rpx; line-height: 28rpx; }
.bc-shine { display: none; }
