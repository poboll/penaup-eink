@import "../../../styles/template-preview.wxss";

.set-card { display: flex; align-items: center; gap: 12rpx; margin-bottom: 18rpx; padding: 8rpx 12rpx 8rpx 18rpx; }
.set-input { flex: 1; min-width: 0; height: 70rpx; color: #20211f; background: transparent; font-size: 24rpx; }
.add-btn { flex-shrink: 0; padding: 12rpx 18rpx; color: #20211f; background: #b7d6c0; border: 2rpx solid #4f775d; border-radius: 7rpx; box-shadow: 3rpx 4rpx 0 rgba(79, 119, 93, .1); font-size: 21rpx; }
.memo-list { padding: 0 18rpx; margin-bottom: 18rpx; }
.memo-item { display: flex; align-items: center; gap: 14rpx; min-height: 72rpx; border-bottom: 2rpx solid #d5d5d1; }
.memo-item:last-of-type { border-bottom: 0; }
.memo-check { flex-shrink: 0; width: 30rpx; height: 30rpx; border: 2rpx solid #9b9c94; border-radius: 3rpx; }
.memo-check.done { background: #55765e; border-color: #55765e; }
.memo-check.done::after { content: '✓'; display: block; color: #fffefa; font-size: 22rpx; line-height: 26rpx; text-align: center; }
.memo-text { flex: 1; overflow: hidden; color: #20211f; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.memo-text.done { color: #9b9c94; text-decoration: line-through; }
.memo-del { color: #b65347; font-size: 22rpx; }
.memo-clear { padding: 18rpx 0; color: #656761; border-top: 2rpx solid #d5d5d1; font-size: 21rpx; text-align: center; }
.memo-empty { margin-bottom: 18rpx; padding: 34rpx 20rpx; border-style: dashed; color: #656761; font-size: 22rpx; text-align: center; }
.canvas-container { margin-top: 0; }
.container > .btn-primary { width: 100%; margin-top: 18rpx; color: #20211f; background: #b7d6c0; border-color: #4f775d; }
