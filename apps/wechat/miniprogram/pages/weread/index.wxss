@import "../../styles/penaup-pages.wxss";

.weread-page { padding-top: 28rpx; }
.weread-hero { padding: 14rpx 4rpx 30rpx; }
.weread-kicker { display: block; color: #4d73ad; font: 600 20rpx/1.3 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: 2rpx; }
.weread-title { display: block; margin-top: 20rpx; color: #20211f; white-space: pre-line; font: 400 60rpx/1.12 Georgia, "Songti SC", serif; }
.weread-lede { display: block; max-width: 650rpx; margin-top: 20rpx; color: #656761; font: 26rpx/1.65 Georgia, "Songti SC", serif; }
.weread-spec { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 24rpx; }
.weread-spec text { padding: 9rpx 14rpx; color: #4d73ad; border: 2rpx solid #b6b7b2; border-radius: 999rpx; font: 20rpx/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; }

.weread-rail { position: relative; display: flex; justify-content: space-between; margin: 8rpx 0 26rpx; padding: 0 8rpx; }
.weread-rail::before { position: absolute; left: 28rpx; right: 28rpx; top: 21rpx; height: 2rpx; content: ''; background: #d5d5d1; }
.rail-item { position: relative; z-index: 1; display: flex; min-width: 82rpx; flex-direction: column; align-items: center; gap: 7rpx; color: #858780; font: 20rpx/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; }
.rail-item text:first-child { display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; border: 2rpx solid #b6b7b2; border-radius: 50%; background: #fafaf7; font-size: 17rpx; }
.rail-item.is-current { color: #20211f; }
.rail-item.is-current text:first-child { color: #fffefa; border-color: #20211f; background: #20211f; }
.rail-item.is-done { color: #55765e; }
.rail-item.is-done text:first-child { color: #fffefa; border-color: #55765e; background: #55765e; }

.weread-card { margin-top: 20rpx; padding: 28rpx 26rpx; border: 2rpx solid rgba(32, 33, 31, .2); border-radius: 8rpx 10rpx 7rpx 9rpx; background: rgba(255, 255, 252, .8); box-shadow: 4rpx 5rpx 0 rgba(42, 41, 36, .08); }
.card-heading { display: flex; align-items: center; gap: 16rpx; min-height: 56rpx; padding-bottom: 20rpx; border-bottom: 2rpx solid #d5d5d1; }
.card-index { display: flex; width: 38rpx; height: 38rpx; align-items: center; justify-content: center; flex-shrink: 0; border: 2rpx solid #b6b7b2; border-radius: 50%; color: #4d73ad; font: 17rpx ui-monospace, SFMono-Regular, Menlo, monospace; }
.card-title { display: block; color: #20211f; font: 400 32rpx/1.2 Georgia, "Songti SC", serif; }
.card-subtitle { display: block; margin-top: 4rpx; color: #858780; font: 20rpx/1.3 ui-monospace, SFMono-Regular, Menlo, monospace; }
.field-label, .choice-label { margin-top: 26rpx; color: #20211f; font: 600 22rpx/1.3 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .5rpx; }
.key-label { margin-top: 24rpx; }
.input-row { display: flex; align-items: stretch; gap: 10rpx; margin-top: 10rpx; }
.paper-input { min-width: 0; flex: 1; min-height: 82rpx; padding: 0 18rpx; color: #20211f; border: 2rpx solid #b6b7b2; border-radius: 8rpx; background: #fffefa; font: 23rpx/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; }
.paper-input::placeholder { color: #858780; }
.key-input { width: 100%; margin-top: 10rpx; }
.address-actions { display: flex; gap: 10rpx; }
.mini-action { min-width: 96rpx; min-height: 82rpx; padding: 0 14rpx; color: #20211f; border: 2rpx solid #b6b7b2; border-radius: 8rpx; background: #fafaf7; font-size: 23rpx; }
.clear-action { color: #656761; border-style: dashed; }
.field-help { display: block; margin-top: 10rpx; color: #7a7c75; font-size: 23rpx; line-height: 1.6; }
.connect-row, .output-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 22rpx; }
.btn-primary, .btn-secondary { min-height: 88rpx; padding: 18rpx 16rpx; border-radius: 2rpx; font-size: 26rpx; line-height: 1.3; box-shadow: 4rpx 4rpx 0 rgba(32, 33, 31, .1); }
.btn-primary { color: #20211f; background: #fffefa; border: 2rpx solid #20211f; }
.btn-secondary { color: #20211f; background: #fffefa; border: 2rpx solid #656761; }
.btn-primary[disabled], .btn-secondary[disabled], .mini-action[disabled] { color: #a5a69e; background: #f4f4f0; border-color: #d5d5d1; box-shadow: none; }
.demo-button { border-style: dashed; }

.choice-grid { display: grid; gap: 10rpx; margin-top: 12rpx; }
.two-col { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.choice-button, .render-button { min-height: 82rpx; padding: 16rpx 12rpx; color: #656761; border: 2rpx solid #d5d5d1; border-radius: 8rpx; background: #fffefa; font-size: 24rpx; box-shadow: 4rpx 4rpx 0 rgba(42, 41, 36, .045); }
.choice-button.is-active, .render-button.is-active { color: #20211f; border-color: #4f775d; background: rgba(183, 214, 192, .3); box-shadow: inset 0 -5rpx #4f775d, 3rpx 4rpx 0 rgba(79, 119, 93, .06); }
.month-picker, .book-picker { display: flex; min-height: 78rpx; align-items: center; justify-content: space-between; gap: 14rpx; margin-top: 12rpx; padding: 0 18rpx; color: #20211f; border: 2rpx solid #b6b7b2; border-radius: 8rpx; background: #fffefa; font-size: 23rpx; }
.month-picker text:last-child, .book-picker text:last-child { color: #4d73ad; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.scene-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; margin-top: 12rpx; }
.scene-button { display: grid; grid-template-columns: 44rpx minmax(0, 1fr); min-width: 0; min-height: 92rpx; align-items: center; gap: 12rpx; padding: 12rpx; color: #656761; border: 2rpx solid #d5d5d1; border-radius: 8rpx; background: #fffefa; box-shadow: 4rpx 4rpx 0 rgba(42, 41, 36, .045); text-align: left; }
.scene-button.is-active { color: #20211f; border-color: #4f775d; background: rgba(183, 214, 192, .3); box-shadow: inset 5rpx 0 #4f775d, 3rpx 4rpx 0 rgba(79, 119, 93, .06); }
.scene-mark { display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; border: 2rpx solid #b6b7b2; border-radius: 50%; color: #4d73ad; font: 17rpx ui-monospace, SFMono-Regular, Menlo, monospace; }
.scene-copy { min-width: 0; }
.scene-title, .scene-detail { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.scene-title { color: inherit; font: 400 26rpx/1.2 Georgia, "Songti SC", serif; }
.scene-detail { margin-top: 6rpx; color: #7a7c75; font-size: 21rpx; }
.render-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.render-button { display: flex; min-height: 84rpx; flex-direction: column; justify-content: center; gap: 5rpx; text-align: left; }
.render-button text:first-child { color: inherit; font: 400 26rpx/1.2 Georgia, "Songti SC", serif; }
.render-button text:last-child { color: inherit; font: 18rpx/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; opacity: .75; }
.render-note { display: block; min-height: 44rpx; margin-top: 14rpx; color: #4d73ad; font-size: 22rpx; line-height: 1.55; }
.color-note { display: block; margin-top: 12rpx; color: #7a7c75; font: 22rpx/1.65 Georgia, "Songti SC", serif; }
.fetch-button { width: 100%; margin-top: 22rpx; }

.status-box { min-height: 78rpx; margin-top: 20rpx; padding: 16rpx 18rpx; color: #656761; border-left: 5rpx solid #b6b7b2; background: rgba(235, 235, 232, .72); font-size: 22rpx; line-height: 1.6; }
.status-box.is-success { color: #55765e; border-left-color: #55765e; background: rgba(85, 118, 94, .08); }
.status-box.is-error { color: #ad5145; border-left-color: #ad5145; background: rgba(173, 81, 69, .08); }
.status-box.is-pending { color: #88680c; border-left-color: #c49a24; background: rgba(196, 154, 36, .1); }
.stats-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8rpx; margin-top: 20rpx; }
.stats-row view { min-height: 104rpx; padding: 14rpx 8rpx; border: 2rpx solid #d5d5d1; border-radius: 8rpx; background: #fffefa; text-align: center; }
.stats-row text { display: block; }
.stats-row text:first-child { color: #20211f; font: 400 31rpx/1.1 Georgia, "Songti SC", serif; }
.stats-row text:last-child { margin-top: 9rpx; color: #7a7c75; font-size: 20rpx; }

.preview-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 16rpx; margin-top: 46rpx; }
.preview-title { display: block; margin-top: 8rpx; color: #20211f; font: 400 38rpx/1.1 Georgia, "Songti SC", serif; }
.preview-size { flex-shrink: 0; padding: 9rpx 11rpx; color: #4d73ad; border: 2rpx solid #b6b7b2; border-radius: 999rpx; font: 19rpx ui-monospace, SFMono-Regular, Menlo, monospace; }
.preview-paper { margin-top: 18rpx; padding: 20rpx 20rpx 30rpx; border: 2rpx solid rgba(32, 33, 31, .2); border-radius: 8rpx 10rpx 7rpx 9rpx; background: rgba(255, 255, 252, .84); box-shadow: 4rpx 5rpx 0 rgba(42, 41, 36, .08), 0 24rpx 50rpx rgba(42, 41, 36, .08); transform: rotate(-.25deg); }
.canvas-wrap { width: 100%; height: calc((100vw - 72rpx) * 1.5); max-height: none; min-height: 0; overflow: hidden; background: #f4f4f0; border: 2rpx solid #d5d5d1; }
.weread-canvas { display: block; width: 100%; height: 100%; }
.preview-caption { display: block; margin-top: 18rpx; color: #656761; font: 21rpx/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; }
.output-note { display: flex; min-height: 86rpx; align-items: center; gap: 14rpx; margin-top: 24rpx; padding: 14rpx 0; color: #656761; border-top: 2rpx solid #d5d5d1; border-bottom: 2rpx solid #d5d5d1; font-size: 21rpx; line-height: 1.55; }
.output-mark { display: flex; width: 66rpx; height: 66rpx; flex-shrink: 0; align-items: center; justify-content: center; color: #4d73ad; border: 2rpx solid #b6b7b2; border-radius: 50%; font: 17rpx ui-monospace, SFMono-Regular, Menlo, monospace; }
.output-actions { margin-top: 20rpx; }

@media (max-width: 620px) {
  .weread-title { font-size: 52rpx; }
  .scene-list { grid-template-columns: 1fr; }
  .render-grid { grid-template-columns: 1fr; }
  .render-button { min-height: 76rpx; flex-direction: row; align-items: center; justify-content: space-between; }
  .render-button text:last-child { margin-left: auto; }
  .preview-heading { align-items: flex-start; flex-direction: column; }
  .preview-size { font-size: 19rpx; }
  .stats-row { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 380px) {
  .weread-card { padding-left: 20rpx; padding-right: 20rpx; }
  .input-row { flex-direction: column; }
  .address-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .mini-action { min-width: 0; }
  .connect-row, .output-actions { grid-template-columns: 1fr; }
  .weread-spec text { font-size: 18rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .weread-page *, .weread-page *::before, .weread-page *::after { animation: none !important; transition: none !important; }
}
