<view wx:if="{{showIntro}}" class="intro-overlay" catchtap="dismissIntro">
  <view class="intro-sheet" catchtap="noop">
    <view class="intro-mark"><view class="intro-leaf leaf-a"></view><view class="intro-leaf leaf-b"></view></view>
    <text class="intro-kicker">PENAUP / E-INK CAMERA</text>
    <text class="intro-title">把喜欢的画面，
留在纸上。</text>
    <view class="intro-colors"><view></view><view></view><view></view><view></view><view></view><view></view></view>
    <text class="intro-hint">轻触进入 · 本地优先</text>
  </view>
</view>

<view class="container">
  <!-- 横幅 -->
  <view class="banner-strip" bindtap="goBluetooth">
    <view class="bn-t">把照片挂上墙</view>
    <view class="bn-s">选一张照片，让六色显影慢慢发生</view>
    <view class="bn-chip">
      <view class="bn-dot {{isConnected ? 'on' : ''}}"></view>
      <text>{{isConnected ? (deviceName || '花生片') + ' 已连接' : '点击连接设备'}}</text>
    </view>
  </view>

  <!-- 设备卡 -->
  <view class="device-row" bindtap="goBluetooth">
    <view class="dev-thumb">
      <image wx:if="{{devThumb}}" src="{{devThumb}}" mode="aspectFill"></image>
      <image wx:elif="{{isConnected}}" src="/images/icons/list.svg" mode="aspectFit"></image>
      <text wx:else>EPD</text>
    </view>
    <view class="dev-info">
      <view class="dev-name">
        <text>{{isConnected ? deviceName : deviceTypeText}}</text>
        <view class="dot {{isConnected ? '' : 'off'}}"></view>
      </view>
      <view class="dev-meta">
        <text wx:if="{{isConnected}}">显示中：《{{currentFile || '—'}}》</text>
        <text wx:else>还没连接 · 点这里开始</text>
      </view>
    </view>
    <view class="dev-batt">
      <view class="num">{{isConnected ? batteryLevel + '%' : '--'}}</view>
      <view class="t">电量</view>
    </view>
  </view>

  <!-- 双 CTA -->
  <view class="cta-row">
    <view class="cta cta-half" bindtap="goCamera">
      <text class="cta-t">拍一张</text>
      <text class="cta-sub">相机直传</text>
    </view>
    <view class="cta cta-half cta-teal" bindtap="sendPhoto">
      <text class="cta-t">传照片</text>
      <text class="cta-sub">从相册挑选</text>
    </view>
  </view>

  <!-- 六色基础颜料通过叠色、网点和抖动形成更丰富的观感 -->
  <view class="color-study">
    <view class="color-study-head">
      <text>EPD / COLOR STUDY</text>
      <text class="color-study-count">6 × 8 = 48</text>
    </view>
    <view class="color-study-palette"><view></view><view></view><view></view><view></view><view></view><view></view></view>
    <view class="color-study-line"><text>6 种基色 × 8 档层级</text><text>最多 48 种观感</text></view>
    <view class="color-study-modes" aria-label="三种显影方式"><text>叠色</text><text>网点</text><text>抖动</text></view>
    <text class="color-study-copy">六色是基础墨粒，不是颜色少一点。叠色、网点与抖动把明暗和过渡织出来，最多形成 48 种色彩观感；画面停住后，电子纸不需要持续点亮。</text>
  </view>

  <!-- 今日模板 -->
  <view class="label">今日模板<text class="pill">超简单</text></view>
  <view class="tpl-row">
    <view class="tpl" bindtap="goToTemplate">
      <view class="t-ic"><image src="/images/icons/template.svg" mode="aspectFit"></image></view>
      <view class="t-name">{{monthName}}</view>
    </view>
    <view class="tpl" bindtap="goToTemplate">
      <view class="t-ic"><image src="/images/icons/countdown.svg" mode="aspectFit"></image></view>
      <view class="t-name">纪念日倒数</view>
    </view>
    <view class="tpl" bindtap="goToTemplate">
      <view class="t-ic"><image src="/images/icons/quote.svg" mode="aspectFit"></image></view>
      <view class="t-name">每日一签</view>
    </view>
  </view>

  <!-- 最近上墙 -->
  <view class="label-row">
    <view class="label">最近上墙</view>
    <view class="clear-recent" wx:if="{{recentList.length > 0}}" bindtap="clearRecent">清除</view>
  </view>
  <view class="recent-row" wx:if="{{recentList.length > 0}}">
    <view class="recent" wx:for="{{recentList}}" wx:key="name" bindtap="tapRecent" data-index="{{index}}">
      <view class="r-img">
        <image wx:if="{{item.thumb}}" src="{{item.thumb}}" mode="aspectFill"></image>
        <image wx:else src="/images/icons/list.svg" mode="aspectFit"></image>
      </view>
      <view class="r-name">{{item.name}}</view>
      <view class="r-time">{{item.time}}</view>
    </view>
  </view>
  <view wx:else class="info-text">还没有发送记录</view>

  <!-- 重新上墙传输弹窗 -->
  <view wx:if="{{showTransfer}}" class="transfer-overlay">
    <view class="transfer-modal" catchtap="noop">
      <view class="flight-area">
        <view class="airplane {{transferOutcome === 'uncertain' ? 'airplane-uncertain' : ''}} {{transferProgress >= 100 ? 'airplane-done' : ''}}"></view>
        <view class="flight-trail"></view>
      </view>
      <view class="transfer-kicker">{{transferPhaseLabel}}</view>
      <view class="transfer-title">{{transferTitle}}</view>
      <view wx:if="{{transferRenderingDetail}}" class="transfer-rendering">显影方式 · {{transferRenderingDetail}}</view>
      <view class="transfer-percent">{{transferProgress}}%</view>
      <view class="transfer-msg">{{transferStatus}}</view>
      <view class="modal-progress-bar">
        <view class="modal-progress-fill" style="width: {{transferProgress}}%"></view>
      </view>
      <view class="transfer-actions" wx:if="{{transferCanRetry || transferCanClose}}">
        <button wx:if="{{transferCanRetry}}" class="btn-primary transfer-retry" bindtap="retryTransfer">再试一次</button>
        <button wx:if="{{transferCanClose}}" class="btn-secondary transfer-close" bindtap="closeTransfer">稍后处理</button>
      </view>
    </view>
  </view>

  <view class="tab-bar-spacer"></view>
</view>
