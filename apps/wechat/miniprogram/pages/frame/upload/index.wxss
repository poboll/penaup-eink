@import "../../../styles/penaup-pages.wxss";

.canvas-container { margin-top: 0; }
.rendering-study {
  margin: 18rpx auto 0;
  padding: 24rpx;
  color: #fffefa;
  background: #222520;
  border: 2rpx solid #474a43;
  border-radius: 8rpx;
  box-shadow: 10rpx 10rpx 0 rgba(26, 27, 24, .08);
}
.rendering-study-head,
.rendering-study-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  color: rgba(247, 247, 242, .62);
  font: 18rpx/1.25 ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: 1rpx;
}
.rendering-study-count { color: #c49a24; font-weight: 600; letter-spacing: 0; }
.rendering-palette { display: flex; gap: 6rpx; height: 12rpx; margin: 24rpx 0 18rpx; }
.rendering-palette view { flex: 1; border-radius: 999rpx; }
.rendering-palette view:nth-child(1) { background: #20211f; border: 2rpx solid rgba(247, 247, 242, .35); }
.rendering-palette view:nth-child(2) { background: #fffefa; }
.rendering-palette view:nth-child(3) { background: #c95849; }
.rendering-palette view:nth-child(4) { background: #c49a24; }
.rendering-palette view:nth-child(5) { background: #4d73ad; }
.rendering-palette view:nth-child(6) { background: #55765e; }
.rendering-study-line { color: rgba(247, 247, 242, .8); letter-spacing: 0; }
.rendering-mode-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8rpx; margin-top: 20rpx; }
.rendering-mode-button {
  display: grid;
  min-height: 76rpx;
  align-content: center;
  gap: 5rpx;
  padding: 10rpx 8rpx;
  color: rgba(247, 247, 242, .72);
  background: transparent;
  border: 2rpx solid rgba(247, 247, 242, .24);
  border-radius: 4rpx;
  text-align: left;
}
.rendering-mode-button::after { border: 0; }
.rendering-mode-button.is-active { color: #fffefa; background: rgba(77, 117, 182, .25); border-color: #8fb1df; box-shadow: inset 0 -4rpx #c49a24; }
.rendering-mode-label { font: 600 24rpx/1.1 Georgia, "Songti SC", serif; }
.rendering-mode-detail { color: inherit; font: 17rpx/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; opacity: .72; }
.rendering-mode-note { display: block; min-height: 38rpx; margin-top: 16rpx; color: rgba(247, 247, 242, .78); font-size: 21rpx; line-height: 1.55; }
.rendering-study-copy { display: block; margin-top: 14rpx; color: rgba(247, 247, 242, .58); font: 21rpx/1.65 Georgia, "Songti SC", serif; }
.button-row { margin-top: 18rpx; }
.btn-send { color: #20211f; background: #b7d6c0; border-color: #4f775d; }
.btn-adjust-on { color: #20211f; background: #fffefa; border-color: #20211f; }

@media (max-width: 620px) {
  .rendering-mode-list { grid-template-columns: 1fr; }
}
