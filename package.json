{
  "name": "penaup-eink",
  "version": "0.1.0",
  "private": true,
  "description": "花生片 Penaup 彩色电子纸拍立得 monorepo",
  "license": "LicenseRef-Poboll-NonCommercial",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "start": "npm --prefix server start",
    "dev": "npm --prefix server run dev",
    "service:install": "node scripts/install-dev-service.mjs",
    "service:status": "node scripts/status-dev-service.mjs",
    "service:uninstall": "node scripts/uninstall-dev-service.mjs",
    "check": "node scripts/check-js.mjs && npm --prefix packages/film-core run check && npm --prefix server run check && npm run check:contracts",
    "check:contracts": "node scripts/release-gate.mjs",
    "test": "npm run test:server && npm run test:film-core && npm run test:wechat && npm run test:release-tools",
    "test:release-tools": "node --test scripts/test/*.test.mjs apps/web/test/*.test.mjs",
    "firmware:manifest:sign": "node scripts/sign-firmware-manifest.mjs",
    "test:server": "npm --prefix server test",
    "test:film-core": "npm --prefix packages/film-core test",
    "test:wechat": "node --test apps/wechat/miniprogram/test/*.test.js",
    "audit": "npm --prefix server audit --omit=dev --registry=https://registry.npmjs.org",
    "release:gate": "npm run check && npm test && npm run audit && node scripts/release-gate.mjs --strict-external",
    "film-core:sync": "npm --prefix server run film-core:sync",
    "migrate:fastapi": "npm --prefix server run migrate:fastapi --",
    "firmware:build:matrix": "node scripts/build-firmware-matrix.mjs"
  }
}
